<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<object class="GtkApplicationWindow" id="settingsWindow">
		<property name="title">Settings</property>
		<property name="default-width">640</property>
		<property name="default-height">480</property>
		<child>
			<object class="GtkBox">
				<property name="orientation">GTK_ORIENTATION_VERTICAL</property>
				<child>
					<object class="GtkBox" id="numbersBox">
					<property name="orientation">GTK_ORIENTATION_VERTICAL</property>
						<child>
							<object class="GtkLabel">
								<property name="label">Numbers</property>
							</object>
						</child>
						<child>
							<object class="GtkLabel">
								<property name="label">Digits</property>
							</object>
						</child>
						<child>
							<object class="GtkSpinButton" id="digitsSpinButton">
								<property name="adjustment">
									<object class="GtkAdjustment">
										<property name="lower">1</property>
										<property name="upper">4</property>
										<property name="step-increment">1</property>
									</object>
								</property>
								<property name="digits">0</property>
								<property name="numeric">true</property>
							</object>
						</child>
						<child>
							<object class="GtkLabel">
								<property name="label">Rows</property>
							</object>
						</child>
						<child>
							<object class="GtkSpinButton" id="rowsSpinButton">
								<property name="adjustment">
									<object class="GtkAdjustment">
										<property name="lower">2</property>
										<property name="upper">10</property>
										<property name="step-increment">1</property>
									</object>
								</property>
								<property name="digits">0</property>
								<property name="numeric">true</property>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>
	</object>
</interface>
